# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Scraper output (data + debug artefacts are not source)
output/
!output/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet
*.jsonl
*.html.gz

# Local config may contain machine-specific paths
config.yaml

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Data and machine-local artefacts.
#
# The GitHub repository is public. Scraped listings carry `seller_name`, `city`
# and free-text `description` -- exactly the fields `scrub.py` exists to protect
# -- so no observation data is published here. The database is the source of
# truth and it stays on the machine that collected it.
# ---------------------------------------------------------------------------
monitor_data/
daily_snapshots/
reports/
deep_scraper/data/
logs/
*.csv
!tests/**/*.csv
!deep_scraper/tests/**/*.csv
!tests_monitor/**/*.csv

# Secrets. Rendered by install_launchd.sh, mode 600, never committed.
deploy/macos/monitor.env
*.env
!*.env.example

# Generated by the installer: absolute paths for THIS machine only.
deploy/macos/*.rendered.sh

# Scratch
